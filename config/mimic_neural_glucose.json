{
    "schema_version": "neural-glucose-training-v1",
    "prediction_target": "future_hospital_laboratory_glucose_mg_dl",
    "forecast_horizons_minutes": [360],
    "horizon_tolerance_minutes": 180.0,
    "target_standardization": "train_only_zscore_per_horizon",
    "seed": 42,
    "epochs": 120,
    "learning_rate": 0.001,
    "weight_decay": 0.0005,
    "expert_loss_weight": 0.2,
    "model": {
      "hidden_dim": 32,
      "embedding_dim": 16,
      "dropout": 0.15,
      "min_scale": 0.05,
      "modality_dropout_probability": 0.0
    },
    "forecast_mode": "ehr_laboratory",
    "input_cgm": false,
    "feature_registry": {
      "ehr": [
        "ehr_age_years",
        "ehr_sex_female",
        "ehr_hours_since_admission",
        "ehr_current_glucose_mg_dl",
        "ehr_previous_glucose_mg_dl",
        "ehr_hours_since_previous_glucose",
        "ehr_glucose_mean_24h",
        "ehr_glucose_std_24h",
        "ehr_glucose_min_24h",
        "ehr_glucose_max_24h",
        "ehr_glucose_slope_24h_mg_dl_per_hour",
        "ehr_glucose_count_24h",
        "ehr_creatinine_last",
        "ehr_creatinine_age_hours",
        "ehr_creatinine_available",
        "ehr_urea_nitrogen_last",
        "ehr_urea_nitrogen_age_hours",
        "ehr_urea_nitrogen_available",
        "ehr_sodium_last",
        "ehr_sodium_age_hours",
        "ehr_sodium_available",
        "ehr_potassium_last",
        "ehr_potassium_age_hours",
        "ehr_potassium_available",
        "ehr_bicarbonate_last",
        "ehr_bicarbonate_age_hours",
        "ehr_bicarbonate_available",
        "ehr_lactate_last",
        "ehr_lactate_age_hours",
        "ehr_lactate_available",
        "ehr_hemoglobin_last",
        "ehr_hemoglobin_age_hours",
        "ehr_hemoglobin_available",
        "ehr_white_blood_cells_last",
        "ehr_white_blood_cells_age_hours",
        "ehr_white_blood_cells_available",
        "ehr_albumin_last",
        "ehr_albumin_age_hours",
        "ehr_albumin_available",
        "ehr_magnesium_last",
        "ehr_magnesium_age_hours",
        "ehr_magnesium_available"
      ]
    },
    "risk_thresholds_mg_dl": {
      "hypoglycemia": 70.0,
      "hyperglycemia": 180.0
    },
    "meal_context": {
      "lookback_minutes": 240,
      "lag_centers_minutes": [0, 30, 60, 120],
      "lag_width_minutes": 30,
      "value_columns": ["carbohydrate_g"],
      "require_event_and_available_time_before_anchor": true
    },
    "gradient_clip_norm": 1.0,
    "early_stopping_patience": 15,
    "minimum_delta": 0.0001,
    "device": "cpu",
    "checkpoint_relative_path": "outputs/models/mimic_neural_glucose.pt"
  }
  