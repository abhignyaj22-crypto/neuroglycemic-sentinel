{
  "schema_version": "neural-glucose-training-v1",
  "prediction_target": "future_cgm_glucose_mg_dl",
  "forecast_horizons_minutes": [
    30,
    60
  ],
  "target_standardization": "train_only_zscore_per_horizon",
  "seed": 42,
  "epochs": 100,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "expert_loss_weight": 0.25,
  "crps_loss_weight": 0.1,
  "lr_warmup_epochs": 5,
  "lr_min_ratio": 0.05,
  "ema_decay": 0.999,
  "model": {
    "hidden_dim": 48,
    "embedding_dim": 24,
    "dropout": 0.1,
    "min_scale": 0.05,
    "modality_dropout_probability": 0.15,
    "cross_modal_layers": 1,
    "cross_modal_heads": 4,
    "horizon_film": true,
    "response_kernel": {
      "channels": {
        "carbohydrate_g": 1.0,
        "protein_g": 1.0,
        "fat_g": 1.0,
        "fiber_g": 1.0,
        "bolus_insulin_units": -1.0
      },
      "basis_centers_minutes": [
        0,
        15,
        30,
        45,
        60,
        90,
        120,
        180
      ],
      "rank": 4,
      "max_gain_deviation": 0.25
    }
  },
  "forecast_mode": "ambient_no_cgm",
  "input_cgm": false,
  "feature_registry": {
    "eeg": [
      "eeg_delta_mean",
      "eeg_theta_mean",
      "eeg_alpha_mean",
      "eeg_beta_mean",
      "eeg_gamma_mean",
      "eeg_delta_variability",
      "eeg_theta_variability",
      "eeg_alpha_variability",
      "eeg_beta_variability",
      "eeg_gamma_variability",
      "eeg_theta_alpha_ratio",
      "eeg_beta_alpha_ratio",
      "eeg_source_count",
      "eeg_alpha_between_source_std",
      "eeg_beta_between_source_std"
    ],
    "wearable": [
      "wearable_ihealth_heart_rate_mean_bpm",
      "wearable_ihealth_spo2_mean_percent",
      "wearable_ihealth_systolic_bp_last_mmhg",
      "wearable_ihealth_diastolic_bp_last_mmhg",
      "wearable_pulse_heart_rate_mean_bpm",
      "wearable_pulse_spo2_mean_percent",
      "wearable_pulse_ppg_variability"
    ]
  },
  "risk_thresholds_mg_dl": {
    "hypoglycemia": 70.0,
    "hyperglycemia": 180.0
  },
  "meal_context": {
    "lookback_minutes": 240,
    "lag_centers_minutes": [
      0,
      15,
      30,
      45,
      60,
      90,
      120,
      180
    ],
    "lag_width_minutes": 20,
    "value_columns": [
      "carbohydrate_g",
      "protein_g",
      "fat_g",
      "fiber_g",
      "bolus_insulin_units"
    ],
    "require_event_and_available_time_before_anchor": true
  },
  "gradient_clip_norm": 1.0,
  "early_stopping_patience": 12,
  "minimum_delta": 0.0001,
  "device": "cpu",
  "checkpoint_relative_path": "outputs/models/neural_glucose_lsl_best.pt"
}