{
  "schema_version": "neural-glucose-training-v1",
  "prediction_target": "future_cgm_glucose_mg_dl",
  "forecast_horizons_minutes": [30, 60],
  "target_standardization": "train_only_zscore_per_horizon",
  "seed": 42,
  "epochs": 100,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "expert_loss_weight": 0.25,
  "model": {
    "hidden_dim": 32,
    "embedding_dim": 16,
    "dropout": 0.1,
    "min_scale": 0.05
  },
  "forecast_mode": "ambient_no_cgm",
  "input_cgm": false,
  "feature_registry": {
    "wearable": [
      "wearable_e4_hr_mean",
      "wearable_e4_hr_std",
      "wearable_e4_hr_slope_per_minute",
      "wearable_e4_hr_successive_difference_rmssd",
      "wearable_eda_mean",
      "wearable_eda_std",
      "wearable_temperature_mean",
      "wearable_temperature_std",
      "wearable_activity_mean",
      "wearable_activity_std",
      "wearable_breathing_rate_mean",
      "wearable_breathing_rate_std"
    ]
  },
  "risk_thresholds_mg_dl": {
    "hypoglycemia": 70.0,
    "hyperglycemia": 180.0
  },
  "meal_context": {
    "lookback_minutes": 240,
    "lag_centers_minutes": [0, 15, 30, 45, 60, 90, 120, 180],
    "lag_width_minutes": 20,
    "value_columns": [
      "carbohydrate_g",
      "protein_g",
      "fat_g",
      "fiber_g",
      "bolus_insulin_units"
    ],
    "require_event_and_available_time_before_anchor": true
  },
  "gradient_clip_norm": 1.0,
  "early_stopping_patience": 12,
  "minimum_delta": 0.0001,
  "device": "cpu",
  "checkpoint_relative_path": "outputs/models/physiocgm_wearable_best.pt"
}
